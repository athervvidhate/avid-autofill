{
  "name": "avid-autofill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that autofills job applications from your saved profile.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc -p .",
    "lint": "biome check .",
    "test": "vitest run",
    "test:browser": "wxt build && node test/extension-browser.mjs && node test/tracker-browser.mjs",
    "import": "node build/import-from-career-ops.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/chrome": "^0.3.5",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
